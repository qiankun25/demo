# indexing_service
INDEX_DATABASE_URL=postgresql://index_user:index_pass@localhost:5436/indexing
INDEX_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# API Settings
INDEX_PORT=8020

# Chroma
INDEX_CHROMA_PERSIST_DIR=.chroma
INDEX_CHROMA_COLLECTION=paper_chunks
INDEX_CHROMA_DISTANCE=cosine

# Embedding
INDEX_EMBED_DIM=256
INDEX_CONTENT_HASH_MAX_LENGTH=2000000

# RabbitMQ Settings
INDEX_NEXUS_CMD_EXCHANGE=nexus.cmd.exchange
INDEX_NEXUS_EVT_EXCHANGE=nexus.evt.exchange
INDEX_INDEX_CMD_ROUTING_KEY=cmd.indexer.start
INDEX_INDEX_CMD_QUEUE=q.index.worker
INDEX_NEXUS_PREFETCH=4
INDEX_EVT_INDEXER_FINISHED=evt.indexer.finished
INDEX_EVT_INDEXER_FAILED=evt.indexer.failed

# External Service Settings
INDEX_INDEX_PARSER_BASE_URL=http://localhost:8031
INDEX_HTTP_CLIENT_TIMEOUT=30.0

# MQ Worker Settings
INDEX_OUTBOX_BATCH_SIZE=20
INDEX_OUTBOX_POLL_INTERVAL=0.2

# Search Settings
INDEX_RRF_K=60
INDEX_SEARCH_MULTIPLIER=3
INDEX_FTS_LANGUAGE=english

# KB Overview Settings
INDEX_KB_DEFAULT_LIMIT=20
INDEX_KB_DEFAULT_OFFSET=0
INDEX_KB_MAX_LIMIT=200

# CORS Settings
INDEX_CORS_ORIGINS=*

# Logging Settings
INDEX_LOG_LEVEL=INFO

