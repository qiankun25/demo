# ============================================
# 生产环境配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 修改所有 CHANGE_ME 开头的值
# 3. 确保敏感信息不要提交到版本控制
# ============================================

# --------------------------------------------
# 应用基础配置
# --------------------------------------------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4

# --------------------------------------------
# 数据库配置（PostgreSQL）
# --------------------------------------------
DATABASE_URL=postgresql://prod_user:CHANGE_ME_STRONG_PASSWORD@db:5432/literature_downloads

# --------------------------------------------
# Redis 配置
# --------------------------------------------
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# --------------------------------------------
# Celery 配置
# --------------------------------------------
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_WORKER_CONCURRENCY=4

# --------------------------------------------
# MinIO/S3 对象存储配置
# --------------------------------------------
# 使用 MinIO（自托管）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_BUCKET=literature-papers
MINIO_SECURE=false

# 使用 AWS S3（取消注释并配置）
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ACCESS_KEY=CHANGE_ME_AWS_ACCESS_KEY
# MINIO_SECRET_KEY=CHANGE_ME_AWS_SECRET_KEY
# MINIO_BUCKET=your-bucket-name
# MINIO_SECURE=true
# AWS_REGION=us-east-1

# 使用阿里云 OSS（取消注释并配置）
# MINIO_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# MINIO_ACCESS_KEY=CHANGE_ME_ALIYUN_ACCESS_KEY
# MINIO_SECRET_KEY=CHANGE_ME_ALIYUN_SECRET_KEY
# MINIO_BUCKET=your-bucket-name
# MINIO_SECURE=true

# --------------------------------------------
# 下载配置
# --------------------------------------------
MAX_FILE_SIZE=104857600  # 100MB（字节）
DOWNLOAD_TIMEOUT=300     # 5分钟（秒）
MAX_RETRIES=3            # 最大重试次数
USER_AGENT=Mozilla/5.0 (compatible; LiteratureBot/1.0)

# --------------------------------------------
# API 配置
# --------------------------------------------
API_RATE_LIMIT=100       # 每分钟请求数
CORS_ORIGINS=https://your-dify-domain.com,https://your-frontend-domain.com

# API Key 认证（用逗号分隔多个 key）
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=CHANGE_ME_API_KEY_1,CHANGE_ME_API_KEY_2

# --------------------------------------------
# 日志配置
# --------------------------------------------
LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json          # json 或 text

# --------------------------------------------
# Webhook 配置（可选）
# --------------------------------------------                                         
# 下载完成后通知的 Webhook URL
WEBHOOK_URL=
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# --------------------------------------------
# 监控配置（可选）
# --------------------------------------------
# Sentry 错误追踪
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Prometheus 指标
ENABLE_METRICS=true
METRICS_PORT=9090
