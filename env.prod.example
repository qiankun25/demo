# ============================================
# 生产环境配置文件
# ============================================
# 使用方法: cp env.prod.example .env.prod
# 然后根据实际情况修改 .env.prod 中的配置值
# 最后: docker-compose --env-file .env.prod up -d
# ============================================

# ============================================
# 基础设施配置
# ============================================

# --- RabbitMQ 配置 ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=WFWwfw123...

# --- MinIO 配置 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Redis 配置 ---
REDIS_PASSWORD=WFWwfw123...
REDIS_URL=redis://:WFWwfw123...@redis:6379/0

# ============================================
# 数据库配置
# ============================================

# --- MySQL 数据库配置（外部服务器：101.132.102.157）---
# 注意：MySQL 部署在外部服务器，不是 Docker 容器
MYSQL_HOST=101.132.102.157
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=WFWwfw123...
MYSQL_DATABASE=wfw_db
MYSQL_USER=app_user
MYSQL_PASSWORD=WFWwfw123...

# --- PostgreSQL 数据库配置 ---
# Downloads 数据库
POSTGRES_DB_DOWNLOADS=downloads
POSTGRES_USER_DOWNLOADS=user
POSTGRES_PASSWORD_DOWNLOADS=WFWwfw123...

# Discovery 数据库
POSTGRES_DB_DISCOVERY=discovery
POSTGRES_USER_DISCOVERY=discovery_user
POSTGRES_PASSWORD_DISCOVERY=WFWwfw123...

# Parser 数据库
POSTGRES_DB_PARSER=parser
POSTGRES_USER_PARSER=parser_user
POSTGRES_PASSWORD_PARSER=WFWwfw123...

# Indexing 数据库
POSTGRES_DB_INDEXING=indexing
POSTGRES_USER_INDEXING=index_user
POSTGRES_PASSWORD_INDEXING=WFWwfw123...

# ============================================
# Application Service 配置
# ============================================

# 数据库连接 URL（使用外部 MySQL 服务器）
APPLICATION_DATABASE_URL=mysql+pymysql://app_user:WFWwfw123...@101.132.102.157:3306/wfw_db?charset=utf8mb4

# 数据库单独配置项（当 DATABASE_URL 未设置时使用）
DB_HOST=101.132.102.157
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=WFWwfw123...
DB_NAME=wfw_db

# Application Service 端口（外部映射端口）
APPLICATION_SERVICE_PORT=8005

# Application Service API URL（内部 Docker 网络使用，容器内部端口仍为8000）
APPLICATION_API_BASE_URL=http://application_service:8000/api/v1
APPLICATION_BASE_HOST=http://application_service:8000

# ============================================
# 工具服务 URL 配置（Docker 内部网络）
# ============================================

# 翻译服务
TRANSLATOR_SERVICE_BASE_URL=http://translator_service:8002

# 索引服务
INDEXING_SERVICE_BASE_URL=http://indexing_service_api:8020

# 解析服务
PARSER_SERVICE_BASE_URL=http://parser_service_api:8031

# 检索服务
RETRIEVAL_SERVICE_BASE_URL=http://retrieval_service:8003

# 概览服务
OVERVIEW_SERVICE_BASE_URL=http://overview_service_api:8040

# 下载服务
DOWNLOAD_SERVICE_BASE_URL=http://download_service_api:8000

# MinIO 上传服务
MINIO_UPLOAD_URL=http://download_service_api:8000/upload

# Nexus 服务
NEXUS_SERVICE_BASE_URL=http://nexus:8000

# ============================================
# Frontend 配置
# ============================================

# 前端端口
FRONTEND_PORT=3000

# 前端构建时环境变量（这些值会在构建时注入到前端代码中）
# 注意：这些 URL 应该是外部可访问的地址（用户浏览器访问的地址）
# 如果使用 Nginx 反向代理，应该使用代理后的地址
# 如果使用 IP 地址，请替换为实际的服务器 IP
VITE_API_BASE_URL=http://your-server-ip:8005/api/v1
# 示例: VITE_API_BASE_URL=http://192.168.1.100:8005/api/v1
# 如果使用域名: VITE_API_BASE_URL=http://api.yourdomain.com/api/v1

VITE_MINIO_UPLOAD_URL=http://your-server-ip:8001/upload
# 示例: VITE_MINIO_UPLOAD_URL=http://192.168.1.100:8001/upload
# 如果使用域名: VITE_MINIO_UPLOAD_URL=http://storage.yourdomain.com:8001/upload

# ============================================
# 可选配置
# ============================================

# SiliconFlow API Key（用于 Overview Service）
# 如果不需要概览生成功能，可以留空
SILICONFLOW2_API_KEY=

# SiliconFlow API Base URL（可选，使用默认值）
SILICONFLOW2_API_BASE=https://api.siliconflow.cn/v1/chat/completions

# SiliconFlow Model（可选，使用默认值）
SILICONFLOW2_MODEL=deepseek-ai/DeepSeek-V3

# ============================================
# 部署说明
# ============================================
# 1. 复制此文件: cp env.prod.example .env.prod
# 2. 修改以下关键配置：
#    - MYSQL_HOST: 如果 MySQL 不在 101.132.102.157，请修改
#    - VITE_API_BASE_URL: 替换为实际的外部可访问地址
#    - VITE_MINIO_UPLOAD_URL: 替换为实际的外部可访问地址
#    - SILICONFLOW2_API_KEY: 如果需要概览生成功能，请填写
# 3. 确保防火墙已开放以下端口：
#    - 3000 (Frontend)
#    - 8000 (Nexus)
#    - 8001 (Download Service)
#    - 8002 (Translator Service)
#    - 8003 (Retrieval Service)
#    - 8005 (Application Service)
#    - 8020 (Indexing Service)
#    - 8031 (Parser Service)
#    - 8040 (Overview Service)
#    - 9000, 9001 (MinIO)
#    - 15672 (RabbitMQ Management)
#    - 3306 (MySQL - 如果从外部访问)
#    - 5432, 5434, 5435, 5436 (PostgreSQL)
#    - 6379 (Redis)
#    - 5672 (RabbitMQ)
# 4. 运行部署: docker-compose --env-file .env.prod up -d --build
# ============================================
